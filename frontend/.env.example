# --- Puertos por defecto en este monorepo ---
# • Navegador (interfaz web):  http://localhost:3003   →  npm run dev:web
# • Backend API + Blinks:      http://localhost:3000   →  npm run dev
#
# NEXT_PUBLIC_API_URL debe ser la URL del BACKEND (3000), no la de Next (3003).
# En Vercel: URL pública del backend (Railway/Render) + CORS_ORIGIN en backend.
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL pública de Blinks (si difiere del API, ej. CDN u otro host)
# Si no se define, se usa NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_BLINKS_BASE_URL=https://tu-dominio.com

# Backend API (dashboard / remesas — opcional si usas route /api/pilotos en Next)
# NEXT_PUBLIC_API_URL=https://tu-backend.railway.app

# PostgreSQL Supabase — route handler /api/pilotos (alternativa legacy)
# DATABASE_URL=postgresql://postgres.mfvubhgquumuudnoyiat:...@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase REST (recomendado en Vercel para /api/pilotos)
SUPABASE_URL=https://mfvubhgquumuudnoyiat.supabase.co
# Dashboard → Project Settings → API → anon public key
SUPABASE_ANON_KEY=

# Email aviso nuevo piloto → remesatia@gmail.com (Resend — https://resend.com)
# RESEND_API_KEY=re_...
# PILOTO_NOTIFY_EMAIL=remesatia@gmail.com
# RESEND_FROM=RemesaBlink <onboarding@resend.dev>
# Bot WhatsApp = soporte (mismo número). Ejemplo actual del bot Baileys:
NEXT_PUBLIC_WA_SUPPORT=5215665269591

# Solana (frontend — wallet connect, devnet por defecto)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com

# Escenario /demo (M5 criterio 2 — Blink como MVP link)
# El GET de Actions vive en este frontend (HTTPS holatia.app), no en trycloudflare.
NEXT_PUBLIC_SITE_URL=https://holatia.app
# NEXT_PUBLIC_BLINKS_BASE_URL=https://holatia.app
# NEXT_PUBLIC_MVP_ACTION_PATH=/api/actions/enviar-remesa-usdc
# NEXT_PUBLIC_MVP_EXPLORER_TX=<signature e2e>
# POST (firmar tx) puede apuntar al API local o túnel — no se usa para unfurl:
# BLINKS_UPSTREAM_URL=http://localhost:3001
